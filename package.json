{
  "name": "jiuzhong202018-website",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:fixture": "node scripts/dev.mjs --fixture",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "test:ui": "playwright test",
    "check:public": "node scripts/check-public.mjs",
    "check:release": "node scripts/check-public.mjs --release --require-private",
    "check:git": "node scripts/check-public.mjs --release --require-private --git",
    "worker:check": "wrangler deploy --dry-run --config worker/wrangler.jsonc",
    "import:preview": "node scripts/import.mjs"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261101.1",
    "@playwright/test": "1.64.1",
    "typescript": "5.6.3",
    "wrangler": "4.156.0"
  }
}
